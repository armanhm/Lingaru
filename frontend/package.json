    "@tailwindcss/typography": "^0.5.20",
    "axios": "^1.21.1",
    "i18next": "^27.2.6",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "~1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
